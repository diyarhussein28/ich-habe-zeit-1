{
  "expo": {
    "name": "Ich habe Zeit",
    "slug": "ich-habe-zeit",
    "scheme": "ichhabezeit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A56DB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.ichhabezeit.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:ich-habe-zeit-1-production.up.railway.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A56DB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "de.ichhabezeit.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ich-habe-zeit-1-production.up.railway.app",
              "pathPrefix": "/providers"
            },
            {
              "scheme": "https",
              "host": "ich-habe-zeit-1-production.up.railway.app",
              "pathPrefix": "/listings"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-sharing",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32bf1253-53f6-48b0-93ea-eb28ebe6cb8b"
      }
    },
    "owner": "diyar29",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/32bf1253-53f6-48b0-93ea-eb28ebe6cb8b",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
