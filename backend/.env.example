# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ichhabezeit"

# JWT
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV="development"
API_BASE_URL="http://localhost:3000"

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_RETRIES=3

# Release window
DEFAULT_RELEASE_WINDOW_HOURS=72

# Email (use real SMTP in production)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@ichhabezeit.de"

# SMS (Twilio or similar)
SMS_PROVIDER="stub"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# File storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
AWS_S3_BUCKET=""
AWS_REGION=""

# Mangopay (sandbox)
MANGOPAY_BASE_URL="https://api.sandbox.mangopay.com"
MANGOPAY_CLIENT_ID=""
MANGOPAY_API_KEY=""

# Platform info (for invoices)
PLATFORM_LEGAL_NAME="Ich habe Zeit GmbH"
PLATFORM_COMMISSION_WALLET_ID=""
